
from decimal import Decimal, ROUND_HALF_UP
import json
import time

# TASK 11: Final Milk Payment Calculator

CENT = Decimal("0.01")
BASE_RATE = Decimal("30.00")
BASE_FAT = Decimal("3.5")
BASE_SNF = Decimal("8.5")
FAT_STEP_RATE = Decimal("0.40")
SNF_STEP_RATE = Decimal("0.30")

MIN_FAT = Decimal("2.0")
MAX_FAT = Decimal("7.0")


def money(value):
    return value.quantize(CENT, rounding=ROUND_HALF_UP)


def calculate_rate(fat, snf):
    fat = Decimal(str(fat))
    snf = Decimal(str(snf))

    if not MIN_FAT <= fat <= MAX_FAT:
        raise ValueError("Fat must be between 2.0% and 7.0%.")

    if not Decimal("0") <= snf <= Decimal("100"):
        raise ValueError("SNF must be between 0% and 100%.")

    fat_steps = (fat - BASE_FAT) / Decimal("0.1")
    snf_steps = (snf - BASE_SNF) / Decimal("0.1")

    if fat_steps != fat_steps.to_integral_value():
        raise ValueError("Fat must be in increments of 0.1%.")

    if snf_steps != snf_steps.to_integral_value():
        raise ValueError("SNF must be in increments of 0.1%.")

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_RATE
        + snf_steps * SNF_STEP_RATE
    )

    return money(rate)


def calculate_payment(litres, fat, snf):
    litres = Decimal(str(litres))

    if litres <= 0:
        raise ValueError("Litres must be greater than zero.")

    rate = calculate_rate(fat, snf)
    payment = money(litres * rate)

    return rate, payment


def load_rate_card(filename="rate_card.json"):
    """Load the rate card from a JSON file."""
    try:
        with open(filename, "r") as file:
            data = json.load(file)

        return {
            "base_rate": Decimal(str(data["base_rate"])),
            "base_fat": Decimal(str(data["base_fat"])),
            "base_snf": Decimal(str(data["base_snf"])),
            "fat_step_rate": Decimal(str(data["fat_step_rate"])),
            "snf_step_rate": Decimal(str(data["snf_step_rate"])),
        }

    except (OSError, ValueError, KeyError, TypeError):
        print("Using the built-in example rate card.")
        return {
            "base_rate": BASE_RATE,
            "base_fat": BASE_FAT,
            "base_snf": BASE_SNF,
            "fat_step_rate": FAT_STEP_RATE,
            "snf_step_rate": SNF_STEP_RATE,
        }


def run_tests():
    print("\nAUTOMATED TESTS")
    tests = [
        ("Standard values", "10", "3.5", "8.5", "300.00"),
        ("Higher fat and SNF", "10", "4.0", "8.7", "326.00"),
        ("Lower fat and SNF", "10", "3.0", "8.0", "265.00"),
        ("Minimum fat", "10", "2.0", "8.5", "240.00"),
        ("Maximum fat", "10", "7.0", "8.5", "440.00"),
    ]

    for name, litres, fat, snf, expected in tests:
        rate, payment = calculate_payment(litres, fat, snf)
        assert payment == Decimal(expected)
        print(f"{name}: PASS | Rate Rs.{rate} | Payment Rs.{payment}")

    invalid_tests = [
        ("Text quantity", "abc", "3.5", "8.5"),
        ("Negative quantity", "-5", "3.5", "8.5"),
        ("Fat below range", "10", "1.5", "8.5"),
        ("Fat above range", "10", "7.5", "8.5"),
    ]

    for name, litres, fat, snf in invalid_tests:
        try:
            calculate_payment(litres, fat, snf)
            raise AssertionError(name + " should be rejected")
        except ValueError:
            print(f"{name}: PASS | Invalid input rejected")


def main():
    print("DAIRY CO-OPERATIVE MILK PAYMENT SYSTEM")

    # Test first
    run_tests()

    print("\nTEN-DAY PAYMENT CALCULATION")
    farmer_id = input("Enter farmer ID: ").strip()

    if not farmer_id:
        print("Farmer ID cannot be empty.")
        return

    total = Decimal("0.00")

    for day in range(1, 11):
        print(f"\nDay {day}")

        while True:
            try:
                litres = input("Enter litres: ")
                fat = input("Enter fat percentage: ")
                snf = input("Enter SNF percentage: ")
                shift = input("Enter shift (morning/evening): ").strip().lower()

                if shift not in ("morning", "evening"):
                    raise ValueError("Shift must be morning or evening.")

                rate, payment = calculate_payment(litres, fat, snf)
                break

            except (ValueError, ArithmeticError) as error:
                print("Invalid entry:", error)
                print("Please enter this day's details again.")

        total += payment

        print("Farmer ID:", farmer_id)
        print("Shift:", shift)
        print("Rate per litre: Rs.", rate)
        print("Payment: Rs.", payment)
        print("Running total: Rs.", money(total))

    print("\nFINAL TEN-DAY STATEMENT")
    print("Farmer ID:", farmer_id)
    print("Total payment: Rs.", money(total))


if __name__ == "__main__":
    # Measure calculator test execution time
    start = time.perf_counter()
    main()
    elapsed = time.perf_counter() - start
    print(f"\nExecution time: {elapsed:.6f} seconds")
