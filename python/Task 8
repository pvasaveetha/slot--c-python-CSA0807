ALGORITHM TenDayMilkPayment

BEGIN
    INPUT farmer_id
    total_amount ← 0

    FOR day ← 1 TO 10 DO
        INPUT litres, fat, snf, shift

        IF litres > 0 AND fat >= 0 AND snf >= 0
           AND shift IS VALID THEN

            rate ← CALCULATE_RATE(fat, snf)
            payment ← litres × rate
            total_amount ← total_amount + payment

            DISPLAY farmer_id, day, rate, payment
        ELSE
            DISPLAY "Invalid entry"
            REPEAT ENTRY FOR THE SAME DAY
        END IF
    END FOR

    DISPLAY "Ten-day total =", total_amount
END
