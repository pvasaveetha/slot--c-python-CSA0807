
from decimal import Decimal
import sys

# 1,000 payments of Rs 33.40 and three adjustments of Rs 0.10
payments = ["33.40"] * 1000 + ["0.10"] * 3


def total_float(items):
    total = 0.0
    for amount in items:
        total += float(amount)
    return total


def total_decimal(items):
    total = Decimal("0.00")
    for amount in items:
        total += Decimal(amount)
    return total


print("float  :", total_float(payments))
print("Decimal:", total_decimal(payments))

print(
    0.1 + 0.2 == 0.3,
    Decimal("0.1") + Decimal("0.2") == Decimal("0.3")
)

# Change Decimal(amount) to Decimal(float(amount))
def total_decimal_float(items):
    total = Decimal("0.00")
    for amount in items:
        total += Decimal(float(amount))
    return total

print("Decimal from float:", total_decimal_float(payments))

# Alternative 1: Store money in integer paise
def total_paise(items):
    total = 0
    for amount in items:
        rupees, paise = amount.split(".")
        total += int(rupees) * 100 + int(paise.ljust(2, "0"))
    return total

print("Integer paise:", total_paise(payments), "paise")
print("Integer paise in rupees:", total_paise(payments) / 100)

# Alternative 2: Round after every float addition
def total_float_round(items):
    total = 0.0
    for amount in items:
        total = round(total + float(amount), 2)
    return total

print("Float with round:", total_float_round(payments))

# Memory comparison (sizes are implementation-dependent)
print("Size of int 3340:", sys.getsizeof(3340), "bytes")
print("Size of float 33.40:", sys.getsizeof(33.40), "bytes")
print("Size of Decimal 33.40:", sys.getsizeof(Decimal("33.40")), "bytes")
